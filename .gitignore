# Match both the real directory AND a `node_modules` symlink (a materialized
# predist run / a git-worktree can leave a symlink named node_modules; the
# trailing-slash form below only ignores directories, so a symlink slipped
# through and got committed once — see the node_modules untrack commit).
node_modules
node_modules/
dist/
.turbo/
.vite/
*.tsbuildinfo
*.tmp
*.bak
*.orig
*~
.env
.env.local
# npm auth token — never commit. CI passes the token via NPM_CONFIG_TOKEN env,
# not a checked-in .npmrc.
.npmrc
.env.*.local
logs/
log/
*.log
.DS_Store
coverage/
.vscode/
.idea/
pnpm-lock.yaml

# Agent run artifacts
examples/prd-agent/output/*
!examples/prd-agent/output/.gitkeep
examples/prismo-agent/output/
examples/*/.runs/
.code-shell/

# Test outputs (AI news drafts, slides, codex research, PPT/PDF
# artifacts). Tools like scripts/gen-recent-pptx.ts write here; the
# contents are throwaway. Keep the directory marker so the path exists.
docs/test-outputs/*
!docs/test-outputs/.gitkeep
out/

# Code-review deliverables (reports, screenshots, probe scripts). One-off
# artifacts produced per review round and superseded by the next one — the
# findings that matter land as commits, tests, and CHANGELOG entries instead.
#
# Scoped to code-review-* ONLY: artifacts/ also holds real product assets
# (artifacts/mimi-papillon-pet/** — the Pet spritesheets, 29 tracked files),
# so a blanket `artifacts/` rule must not be used here.
artifacts/code-review-*/

# 宣传片生成产物（61M：mp4 录屏/成片、TTS 试听音频、QA 缩略图、
# HyperFrames 合成工程）。和 video-output/ 同性质 —— 跑一遍就能重新生成，
# 二进制大文件不该进仓库。同样只限定到这一个子目录，不能写成整个 artifacts/。
artifacts/codeshell-intro-video/

# Job Hunt HQ 的个人数据：简历素材、工作经历、面试记录、联系方式和面板快照，
# 都是本人隐私而不是源码。CODESHELL.md 把这两个路径写成了权威入口，所以目录
# 结构要保留 —— 只忽略内容，放行 jd/README.md 这类模板说明。
career-data/*
!career-data/jd/
career-data/jd/*
!career-data/jd/README.md
job-hunt-panel.json

# design-studio Panel App runtime output. The app writes designs into the
# workspace at these exact paths (see its workspace.writeText calls and the
# `designs/*.codesign.json` paths in the Panel App tests), and the HTML export
# lands in design-output/. Both are regenerated by running the app — user data,
# not source.
designs/
design-output/

# superpowers skills' local runtime state (PID/log/events files per
# brainstorm session). Pure machine-local — every run regenerates.
# Brainstorm "content/" output (HTML/MD artifacts) is intentionally
# allowed through.
.superpowers/brainstorm/*/state/

# Claude Code session state: worktrees created by EnterWorktree / git
# worktree add live here. Local only — never commit worktree contents.
.claude/worktrees/
packages/desktop/.preview/

# Project-local Archify installation. `npx skills add --agent "*"` fans the
# third-party runtime out to multiple agent-compatible locations and writes a
# local provenance lock. The generated diagrams under docs/architecture/ stay
# tracked; only the reinstallable Skill runtime is machine-local.
/.agents/skills/archify/
/agent/skills/archify/
/.claude/skills/archify
/data/skills/archify
/skills-lock.json

# Renderer source 'logs/' view dir is NOT a runtime-logs dir — keep it tracked
!packages/desktop/src/renderer/logs/
!packages/desktop/src/renderer/logs/**

# nightly loop bookkeeping (untracked)
.loop/
packages/web/dist-app/

# 视频生成产物，throwaway
video-output/

# Investment Desk legacy workspace output. Panel API v11 writes new live and
# selection snapshots to Host-managed panel-app-data instead; keep existing
# CSVs, reports, news state, and portfolio records local and out of Git.
/data/market/
/data/market-insights/
/data/news/
/portfolio/

# Privacy-filtered personal eval exports. The README/schema stay tracked, but
# generated cases and trace snapshots remain local unless deliberately moved
# into a separately access-controlled dataset repository.
/evals/personal-sanitized/*
!/evals/personal-sanitized/README.md
!/evals/personal-sanitized/SCHEMA.md
