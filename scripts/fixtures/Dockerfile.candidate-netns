# Test helper only. Do not use as the production project-runtime image.
FROM node:22-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
# The signed historical snapshot also freezes dependencies. Valid-Until is
# disabled only for this immutable archive; APT signature checks remain enabled.
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20250301T000000Z bookworm main\n' > /etc/apt/sources.list \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get install -y --no-install-recommends iptables=1.8.9-2 \
    && mkdir /helper \
    && dpkg-query -W -f='${Package}=${Version}\n' > /helper/dpkg.txt \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/docker-candidate-netns.mjs /docker-candidate-netns.mjs
COPY scripts/fixtures/docker-candidate-netns-entry.mjs /helper/docker-candidate-netns-entry.mjs
RUN node --input-type=module -e 'import{readFileSync,writeFileSync,realpathSync}from"node:fs";import{createHash}from"node:crypto";const names=["/usr/sbin/iptables","/usr/sbin/ip6tables","/usr/sbin/iptables-restore","/usr/sbin/ip6tables-restore","/docker-candidate-netns.mjs","/helper/docker-candidate-netns-entry.mjs"];writeFileSync("/helper/inventory.json",JSON.stringify({base:"sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9",snapshot:"20250301T000000Z",packages:readFileSync("/helper/dpkg.txt","utf8"),files:names.map(path=>({path,realpath:realpathSync(path),sha256:createHash("sha256").update(readFileSync(path)).digest("hex")}))}));'
ENTRYPOINT ["node", "/helper/docker-candidate-netns-entry.mjs"]
