{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "react/compiler-runtime": ["./src/react-compiler-runtime-shim.js"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // Keep the dormant Arena command source for its private capability package;
  // it is not a terminal entry point and must not ship in the public TUI.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/cli/commands/arena.ts"
  ]
}
