{
  "name": "@cjhyy/code-shell-web",
  "version": "0.9.45",
  "description": "CodeShell web client logic layer — remote-app state (chatReducer + server-event fold), reconnecting WebSocket hook, pairing/device-credential/risk helpers, and the mobile i18n namespace. Browser-only (no Electron, no Node); seed of the standalone browser client.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dist-app"
  ],
  "scripts": {
    "test:latest-browser": "node scripts/test-latest-messages.mjs",
    "build": "bun run clean && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "build:app": "vite build",
    "test:sidebar-browser": "node scripts/test-sidebar-navigation.mjs",
    "test:settings-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-settings-browser.mjs",
    "test:skills-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-skills-browser.mjs",
    "test:model-actions-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-model-actions-browser.mjs",
    "test:mcp-settings-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-mcp-settings-browser.mjs",
    "test:history-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-history-browser.mjs",
    "test:links-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-links-browser.mjs",
    "test:sidebar-focus-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-sidebar-focus-browser.mjs",
    "test:devices-browser": "node ../../scripts/run-isolated-node-smoke.mjs scripts/test-devices-browser.mjs",
    "dev:app": "vite dev",
    "test:files-browser": "node scripts/test-file-browser.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('dist-app',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@cjhyy/code-shell-core": "workspace:*",
    "@cjhyy/code-shell-link": "workspace:*",
    "@types/react": "^19.2.14",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "react": "19.2.6"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^9",
    "remark-gfm": "^4",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjhyy/codeshell.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/cjhyy/codeshell/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/cjhyy/codeshell/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
