{
  "manifest_version": 3,
  "name": "CodeShell Browser Runtime",
  "description": "Explicitly grant a signed-in Chrome tab to a CodeShell task.",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "CodeShell Browser Runtime",
    "default_popup": "popup.html"
  }
}
