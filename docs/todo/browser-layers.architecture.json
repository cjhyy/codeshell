  "cards": [
    {
      "dot": "rose",
      "title": "为什么要拆开",
      "items": [
        "partition 就是 Cookie jar",
        "原由 bucket（含 sessionId）派生 → 每开新 Session 登录态归零",
        "实测 72 个 partition / 1.9 GB，单项目最多 14 份互不相认"
      ]
    },
    {
      "dot": "emerald",
      "title": "共享登录，隔离页面",
      "items": [
        "同项目 Session 共享 profile：一次登录处处可用",
        "各自持有 workspace：不抢对方标签页",
        "要隔离就显式指定 u:<name>，也可跨项目共享（SSO）"
      ]
    },
    {
      "dot": "amber",
      "title": "危险的不是抢 tab，是 tab 被导航走",
      "items": [
        "用户两轮之间点到别处，Agent 可能往错页面提交表单",
        "写前重验：origin / titleHash 不符即失效",
        "移交是持有者赠予，接收方仍受同样校验"
      ]
    }
  ]
