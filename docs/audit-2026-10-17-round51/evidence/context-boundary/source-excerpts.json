    "displayedLines": [
      {
        "line": 1,
        "text": "import type { TFunction } from \"../i18n/I18nProvider\";"
      },
      {
        "line": 2,
        "text": ""
      },
      {
        "line": 3,
        "text": "export interface CompactFeedbackInput {"
      },
      {
        "line": 4,
        "text": "  before: number;"
      },
      {
        "line": 5,
        "text": "  after: number;"
      },
      {
        "line": 6,
        "text": "  strategy: string;"
