        "text": "}"
      },
      {
        "line": 8,
        "text": ""
      },
      {
        "line": 9,
        "text": "const STRATEGY_LABEL_KEYS = {"
      },
      {
        "line": 10,
        "text": "  compacted: \"chat.compact.strategy.compacted\","
      },
      {
        "line": 11,
        "text": "  summary: \"chat.compact.strategy.summary\","
      },
      {
        "line": 12,
        "text": "  notes: \"chat.compact.strategy.notes\","
      },
      {
        "line": 13,
        "text": "  snip: \"chat.compact.strategy.snip\","
      },
      {
        "line": 14,
        "text": "  window: \"chat.compact.strategy.window\","
      },
      {
        "line": 15,
        "text": "  micro: \"chat.compact.strategy.micro\","
      },
      {
        "line": 16,
        "text": "  emergency: \"chat.compact.strategy.emergency\","
      },
      {
        "line": 17,
        "text": "} as const;"
      },
      {
        "line": 18,
        "text": ""
      },
      {
        "line": 19,
        "text": "type KnownCompactStrategy = keyof typeof STRATEGY_LABEL_KEYS;"
      },
      {
        "line": 20,
        "text": ""
      },
      {
        "line": 21,
        "text": "function isKnownCompactStrategy(strategy: string): strategy is KnownCompactStrategy {"
      },
      {
        "line": 22,
        "text": "  return Object.prototype.hasOwnProperty.call(STRATEGY_LABEL_KEYS, strategy);"
      },
      {
        "line": 23,
        "text": "}"
      },
      {
        "line": 24,
        "text": ""
      },
      {
        "line": 25,
        "text": "export function compactStrategyLabel(strategy: string, t: TFunction): string {"
      },
      {
        "line": 26,
        "text": "  return isKnownCompactStrategy(strategy) ? t(STRATEGY_LABEL_KEYS[strategy]) : strategy;"
      },
      {
        "line": 27,
        "text": "}"
      },
      {
        "line": 28,
        "text": ""
      },
      {
        "line": 29,
        "text": "export function compactReductionPercent(before: number, after: number): number {"
      },
      {
        "line": 30,
        "text": "  if (!Number.isFinite(before) || before <= 0) return 0;"
      },
      {
        "line": 31,
        "text": "  const saved = Math.max(0, before - after);"
      },
      {
        "line": 32,
        "text": "  return Math.round((saved / before) * 100);"
      },
      {
        "line": 33,
        "text": "}"
      },
      {
        "line": 35,
        "text": "export function compactWasNoop(result: CompactFeedbackInput): boolean {"
      },
      {
        "line": 36,
        "text": "  return result.after >= result.before;"
      },
      {
        "line": 39,
        "text": "function safeTokenCount(tokens: number): number {"
      },
      {
        "line": 40,
        "text": "  return Number.isFinite(tokens) ? Math.max(0, Math.round(tokens)) : 0;"
      },
      {
        "line": 41,
        "text": "}"
      },
      {
        "line": 42,
        "text": ""
      },
      {
        "line": 43,
        "text": "export function compactPromptTokensWithBaseline("
      },
      {
        "line": 50,
        "text": "  // message-body estimate after manual compaction."
      },
      {
        "line": 51,
        "text": "  const baseline = Math.max(0, safeTokenCount(currentPromptTokens) - safeTokenCount(result.before));"
      },
      {
        "line": 52,
        "text": "  return safeTokenCount(result.after) + baseline;"
      },
      {
        "line": 55,
        "text": "function formatTokenCount(tokens: number, locale?: string): string {"
      },
      {
        "line": 56,
        "text": "  const safe = safeTokenCount(tokens);"
      },
      {
        "line": 57,
        "text": "  return new Intl.NumberFormat(locale).format(safe);"
      },
      {
        "line": 58,
        "text": "}"
      },
      {
        "line": 59,
        "text": ""
      },
      {
        "line": 60,
        "text": "function compactSuccessParams(result: CompactFeedbackInput, t: TFunction, locale?: string) {"
      },
      {
        "line": 61,
        "text": "  return {"
      },
      {
        "line": 62,
        "text": "    before: formatTokenCount(result.before, locale),"
      },
      {
        "line": 63,
        "text": "    after: formatTokenCount(result.after, locale),"
      },
      {
        "line": 64,
        "text": "    percent: compactReductionPercent(result.before, result.after),"
      },
      {
        "line": 65,
        "text": "    strategy: compactStrategyLabel(result.strategy, t),"
      },
      {
        "line": 66,
        "text": "  };"
      },
      {
        "line": 67,
        "text": "}"
      },
      {
        "line": 69,
        "text": "export function compactOutcomeMessage("
      },
      {
        "line": 76,
        "text": "      tokens: formatTokenCount(result.after, locale),"
      },
      {
        "line": 82,
        "text": "export function compactBoundaryDetail("
      },
      {
        "line": 83,
        "text": "  result: CompactFeedbackInput,"
      },
      {
        "line": 84,
        "text": "  t: TFunction,"
      },
      {
        "line": 85,
        "text": "  locale?: string,"
      },
      {
        "line": 86,
        "text": "): string {"
      },
      {
        "line": 87,
        "text": "  return t(\"chat.compact.boundaryDetail\", compactSuccessParams(result, t, locale));"
