 936:     // instead of being replaced wholesale: a user-level (global) hook and a
 937:     // project-level hook should BOTH run, mirroring how Claude Code merges
 938:     // hooks from all settings files. Order follows layer priority (user
 939:     // first, project after). An explicit `"hooks": null` in a layer still
 940:     // resets everything below it (the escape hatch merge() already gives
 941:     // every other key); per-entry opt-out is the `disabled` field.
 942:     let hooks: unknown[] | undefined;
 943:     let hookSources: typeof this.mergedHookSources = [];
 944:     let sawHooks = false;
 945:     for (const source of this.sources) {
 946:       if (!("hooks" in source.data)) continue;
 947:       const v = source.data.hooks;
 948:       if (v === null) {
 949:         hooks = undefined;
 950:         hookSources = [];
 951:         sawHooks = true;
 952:       } else if (Array.isArray(v)) {
 953:         hooks = [...(hooks ?? []), ...v];
 954:         hookSources = [
 955:           ...hookSources,
 956:           ...v.map((_hook, sourceLayerIndex) => ({ source, sourceLayerIndex })),
 957:         ];
 958:         sawHooks = true;
 959:       }
 960:       // Non-array garbage is left to merge()'s wholesale result so
 961:       // validateSettings still sees (and rejects) it unchanged.
 962:     }
 963:     if (sawHooks) {
 964:       if (hooks !== undefined) result.hooks = hooks;
 965:       else delete result.hooks;
 966:     }
 967:     this.mergedHookSources = hookSources;
 968:     return result;
 969:   }
