 458:    */
 459:   getHookOrigins(): readonly (SettingsHookOrigin | undefined)[] {
 460:     if (!this.merged) return Object.freeze([]);
 461:     const hooks = this.merged.hooks ?? [];
 462:     return Object.freeze(
