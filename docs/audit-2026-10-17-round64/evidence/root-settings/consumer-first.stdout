 272:     // Scope gates which disk layers we read. 'full' reads the host user dir
 273:     // (~/.code-shell); 'project' and 'isolated' never do. See SettingsScope.
 274:     const readUser = this.scope === "full";
 275:     const readProject = this.scope !== "isolated";
 276: 
 277:     if (readUser) {
 278:       // 1. Managed (lowest priority)
 279:       this.loadJsonFile(join(this.userConfigDir(), "settings.managed.json"), "managed", 0);
 280: 
 281:       // 2. User — only ~/.code-shell/. We used to also read ~/.claude/settings.json
 282:       // for "zero-migration from Claude Code", but Claude Code's schema diverges
 283:       // (e.g. `model` is a string there, an object here). Merging caused boot
 284:       // crashes on machines that had Claude Code installed but never ran us.
 285:       // File-level compat (CLAUDE.md, .claude/skills/) is kept elsewhere — only
 286:       // the settings.json read is dropped.
 287:       this.loadJsonFile(join(this.userConfigDir(), "settings.json"), "user", 1);
 288:     }
 289: 
 290:     if (readProject) {
 291:       // 3. Project
 292:       const projectPath = this.tryProjectSettingsPath(this.cwd, "settings.json");
 293:       if (projectPath) this.loadJsonFile(projectPath, "project", 2);
 294:       else if (this.hookOriginsEnabled)
 295:         this.unavailableHookPriority = Math.max(this.unavailableHookPriority, 2);
 296: 
 297:       // 4. Local
 298:       const localPath = this.tryProjectSettingsPath(this.cwd, "settings.local.json");
 299:       if (localPath) this.loadJsonFile(localPath, "local", 3);
 300:       else if (this.hookOriginsEnabled)
 301:         this.unavailableHookPriority = Math.max(this.unavailableHookPriority, 3);
 302:     }
 303: 
 304:     // 5. CLI flags (highest priority)
