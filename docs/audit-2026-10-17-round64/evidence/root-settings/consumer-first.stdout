 479:   private clearSourceOrigin(name: SettingsSourceName): void {
 480:     this.sources = this.sources.map((source) => {
 481:       if (source.name !== name) return source;
 482:       const { origin: _origin, ...unpaired } = source;
 483:       return Object.freeze(unpaired);
 484:     });
 485:     this.hookOrigins = Object.freeze((this.merged?.hooks ?? []).map(() => undefined));
 486:     this.mergedHookSources = [];
 487:   }
