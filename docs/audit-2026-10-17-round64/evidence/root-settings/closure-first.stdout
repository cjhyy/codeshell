  48: /**
  49:  * Selection only. Never borrows Engine handlers or runs commands. Preserve the
  50:  * existing settings/plugin matcher, disable, approval and priority contracts.
  51:  */
  52: export function prepareConfiguredToolHooks(options: {
  53:   settings: SettingsManager;
  54:   cwd: string;
  55:   settingsScope: SettingsScope;
  56:   disabledPlugins: string[];
  57:   disabledPluginHooks: string[];
  58:   toolName: string;
  59: }) {
  60:   const events = new Set<HookEventName>(TOOL_HOOK_EVENTS);
  61:   const definitions = options.settings.get().hooks ?? [];
  62:   const origins = options.settings.getHookOrigins();
  63:   const plugins = listPluginHooksForHost(options.disabledPlugins);
  64:   const descriptors: ConfiguredToolHook[] = [];
  65:   for (const [index, hook] of definitions.entries()) {
  66:     if (
  67:       !hook.disabled &&
  68:       events.has(hook.event as HookEventName) &&
  69:       shellHookMatches(hook, {
  70:         eventName: hook.event as HookEventName,
  71:         data: { toolName: options.toolName },
  72:       })
  73:     )
  74:       descriptors.push({
  75:         id: `settings:${index}:${sha256(JSON.stringify(hook))}`,
  76:         event: hook.event as HookEventName,
  77:         protocol: "settings",
  78:         priority: 50,
  79:         command: hook.command,
  80:         timeoutMs: Math.min(hook.timeout_ms ?? 60000, 60000),
  81:         ...(hook.cwd === undefined ? {} : { cwd: hook.cwd }),
  82:         ...(origins[index] === undefined ? {} : { source: origins[index] }),
  83:       });
  84:   }
  85:   for (const [index, hook] of plugins.entries()) {
  86:     if (
  87:       hook.disabled ||
  88:       options.disabledPluginHooks.includes(hook.key) ||
  89:       !["approved", "legacy"].includes(hook.approval) ||
  90:       !events.has(hook.event) ||
  91:       !matcherAccepts(hook.event, hook.matcher, {
  92:         eventName: hook.event,
  93:         data: { toolName: options.toolName },
  94:       })
  95:     )
