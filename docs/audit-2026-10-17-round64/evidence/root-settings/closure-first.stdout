 354:     // not read — let alone rewrite — the host's ~/.code-shell/settings.json.
 355:     const userPath = join(this.userConfigDir(), "settings.json");
 356:     if (readUser && resolveConfigPath(userPath) === userPath) {
 357:       try {
 358:         // Read-only loads must retain preceding in-memory version migrations.
 359:         // Ordinary loads preserve their existing disk reread before model migration.
 360:         if (options?.persistMigrations !== false) this.clearSourceOrigin("user");
 361:         const userSource = this.sources.find((source) => source.name === "user");
 362:         const userRaw =
 363:           options?.persistMigrations === false ? userSource?.data : parseConfigFile(userPath);
 364:         if (!userRaw) throw new Error("invalid user settings");
 365:         const result = migrateModels({
 366:           providers: (userRaw.providers as never) ?? [],
 367:           models: (userRaw.models as never) ?? [],
 368:         });
 369:         if (result.changed) {
 370:           const migrated = {
 371:             ...userRaw,
 372:             providers: result.providers,
 373:             models: result.models,
 374:           };
 375:           const sanitized = sanitizeSettingsObject(migrated);
 376:           // Atomic write (tmp+rename) — a concurrent load must not see a
 377:           // half-written file. File exists here (existsSync guard above).
 378:           if (options?.persistMigrations !== false) {
 379:             this.writeBackup(userPath);
 380:             this.atomicWriteJson(userPath, sanitized);
 381:           }
 382:           // Re-deep-merge with the migrated user data so the validate
 383:           // call sees the new shape rather than the legacy one.
 384:           this.replaceSource("user", sanitized, userSource?.origin);
 385:           const remerged = this.deepMerge();
 386:           return this.validateMerged(remerged);
 387:         }
 388:       } catch {
 389:         // Migration is best-effort — fall through to normal validate.
 390:       }
 391:     }
