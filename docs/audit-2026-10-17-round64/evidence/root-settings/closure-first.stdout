  13: export const TOOL_HOOK_EVENTS = [
  14:   "pre_tool_use",
  15:   "on_permission_check",
  16:   "on_tool_start",
  17:   "on_tool_end",
  18:   "post_tool_use",
  19: ] as const satisfies readonly HookEventName[];
  20: 
  21: export interface ConfiguredToolHook {
  22:   id: string;
  23:   event: HookEventName;
  24:   protocol: "settings" | "plugin";
  25:   priority: 50 | 80;
  26:   command: string;
  27:   timeoutMs: number;
  28:   cwd?: string;
  29:   pluginInstallPath?: string;
  30:   source?: PluginHookSource | SettingsHookOrigin;
  31: }
  32: 
  33: function fileIdentity(path: string): unknown {
  34:   try {
  35:     const info = lstatSync(path, { bigint: true });
  36:     if (info.isSymbolicLink()) throw new Error("Hook authority cannot use a symlink");
  37:     // A configuration directory's unrelated state children are not policy.
  38:     // Pin traversal/replacement/permissions; the actual known config files
  39:     // below retain their complete identity, including timestamps and size.
  40:     if (info.isDirectory()) return [path, info.dev, info.ino, info.mode].map(String);
  41:     return [path, info.dev, info.ino, info.mode, info.size, info.mtimeNs, info.ctimeNs].map(String);
  42:   } catch (error) {
  43:     if ((error as NodeJS.ErrnoException).code === "ENOENT") return [path, "absent"];
  44:     throw error;
  45:   }
  46: }
