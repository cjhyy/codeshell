 396:   /**
 397:    * Run the version-based migrations (migrate-config.ts MIGRATIONS) against a
 398:    * single physical settings file. Best-effort: any read/parse/write error
 399:    * falls through silently and the original source data is used as-is.
 400:    * Writes back (with a .bak, like the models[] migration above) ONLY when a
 401:    * step changed actual content — the configVersion stamp alone doesn't
 402:    * justify touching the file. On write-back the in-memory source is updated
 403:    * so this load() already sees the migrated shape.
 404:    */
 405:   private applyConfigMigration(path: string, sourceName: SettingsSourceName, persist = true): void {
 406:     if (resolveConfigPath(path) !== path) return;
 407:     try {
 408:       const source = this.sources.find((s) => s.name === sourceName);
 409:       // The opt-in read-only path migrates its actual same-buffer load. Ordinary
 410:       // loads retain their historical reread, but cannot retain the old origin.
 411:       const paired = !persist && source?.origin !== undefined;
 412:       if (!paired) this.clearSourceOrigin(sourceName);
 413:       const parsed = paired ? source.data : parseConfigFile(path);
 414:       if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) return;
 415:       const raw = sanitizeSettingsObject(parsed as Record<string, unknown>);
 416:       const result = migrateConfig(raw);
 417:       if (!result.changed) return;
 418:       // Compare content with the version stamp normalized away — stamp-only
 419:       // changes are not persisted.
 420:       const stripStamp = (c: Record<string, unknown>): Record<string, unknown> => {
 421:         const { [CONFIG_VERSION_KEY]: _v, ...rest } = c;
 422:         return rest;
 423:       };
 424:       if (JSON.stringify(stripStamp(raw)) === JSON.stringify(stripStamp(result.config))) return;
 425:       // Atomic write (tmp+rename) so a concurrent load can't read a half-written
 426:       // migrated file — matches the normal save path (atomicWriteJson). The file
 427:       // exists here (existsSync guard above), so the recursive mkdir is a no-op.
 428:       const sanitized = sanitizeSettingsObject(result.config as Record<string, unknown>);
 429:       if (persist) {
 430:         this.writeBackup(path);
 431:         this.atomicWriteJson(path, sanitized);
 432:       }
 433:       this.replaceSource(sourceName, sanitized, paired ? source.origin : undefined);
 434:     } catch {
 435:       // Best-effort — fall through to normal merge/validate.
 436:     }
 437:   }
