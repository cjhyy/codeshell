      "path": "packages/core/src/llm/strip-vision.ts",
      "sha256": "d4c2b0f230941c255daefc838f893c8c10137d32595e0ccf6e1d5a7b74ed50c0",
      "capturedAfterActualDisplay": true,
      "blocks": [
        {
          "start": 1,
          "end": 107,
          "lines": [
            {
              "line": 1,
              "text": "/**"
            },
            {
              "line": 2,
              "text": " * History-image stripping for non-vision models."
            },
            {
              "line": 3,
              "text": " *"
            },
            {
              "line": 4,
              "text": " * Why this exists: the vision gate in `Engine.run` only rejects *new* image"
            },
            {
              "line": 5,
              "text": " * attachments on the current turn. But a conversation can accumulate image"
            },
            {
              "line": 6,
              "text": " * content blocks while a vision-capable model is active, then the user"
            },
            {
              "line": 7,
              "text": " * switches to a non-vision model (e.g. DeepSeek) mid-session. Those"
            },
            {
              "line": 8,
              "text": " * *historical* image blocks are still in the transcript and get re-serialized"
            },
            {
              "line": 9,
              "text": " * on every subsequent request — OpenAI-compat backends 400 with"
            },
            {
              "line": 10,
              "text": " * `unknown variant 'image_url', expected 'text'`, which then falls back out"
            },
            {
              "line": 11,
              "text": " * of streaming and degrades the turn."
            },
            {
              "line": 12,
              "text": " *"
            },
            {
              "line": 13,
              "text": " * Fix: when the active model has `supportsVision: false`, replace each"
            },
            {
              "line": 14,
              "text": " * message's image blocks with a single text placeholder before the request"
            },
            {
              "line": 15,
              "text": " * is built. The transcript/store is untouched — only the outgoing copy is"
            },
            {
              "line": 16,
              "text": " * sanitized — so switching back to a vision model still sees the images."
            },
            {
              "line": 17,
              "text": " *"
            },
            {
              "line": 18,
              "text": " * Pure function, no I/O. Tested in `strip-vision.test.ts`."
            },
            {
              "line": 19,
              "text": " */"
            },
            {
              "line": 20,
              "text": ""
            },
            {
              "line": 21,
              "text": "import type { Message, ContentBlock } from \"../types.js\";"
            },
            {
              "line": 22,
              "text": ""
            },
            {
              "line": 23,
              "text": "/** Text we substitute for an elided image block. Surfaced to the model so it"
            },
            {
              "line": 24,
              "text": " *  knows an image *was* here (vs silently vanishing the context). */"
            },
            {
              "line": 25,
              "text": "export const VISION_PLACEHOLDER ="
            },
            {
              "line": 26,
              "text": "  \"[图片已省略:当前模型不支持视觉输入]\";"
            },
            {
              "line": 27,
              "text": ""
            },
            {
              "line": 28,
              "text": "/**"
            },
            {
              "line": 29,
              "text": " * Return a copy of `messages` with image content blocks replaced by a text"
            },
            {
              "line": 30,
              "text": " * placeholder, but only when `supportsVision` is false."
            },
            {
              "line": 31,
              "text": " *"
            },
            {
              "line": 32,
              "text": " * Identity-preserving: when vision is supported, or no message carries an"
            },
            {
              "line": 33,
              "text": " * image, the original array (and untouched message objects) are returned as-is"
            },
            {
              "line": 34,
              "text": " * so callers pay nothing on the common path."
            },
            {
              "line": 35,
              "text": " */"
            },
            {
              "line": 36,
              "text": "export function stripVisionFromHistory("
            },
            {
              "line": 37,
              "text": "  messages: Message[],"
            },
            {
              "line": 38,
              "text": "  supportsVision: boolean,"
            },
            {
              "line": 39,
              "text": "): Message[] {"
            },
            {
              "line": 40,
              "text": "  if (supportsVision) return messages;"
            },
            {
              "line": 41,
              "text": ""
            },
            {
              "line": 42,
              "text": "  let changed = false;"
            },
            {
              "line": 43,
              "text": "  const out = messages.map((msg) => {"
            },
            {
              "line": 44,
              "text": "    if (typeof msg.content === \"string\") return msg;"
            },
            {
              "line": 45,
              "text": "    // Need to process if there's a top-level image, OR a tool_result whose"
            },
            {
              "line": 46,
              "text": "    // own content array carries a nested image (view_image-produced screenshots"
            },
            {
              "line": 47,
              "text": "    // live in `tool_result.content: ContentBlock[]`)."
            },
            {
              "line": 48,
              "text": "    if (!msg.content.some(needsStrip)) return msg;"
            },
            {
              "line": 49,
              "text": ""
            },
            {
              "line": 50,
              "text": "    changed = true;"
            },
            {
              "line": 51,
              "text": "    const rebuilt: ContentBlock[] = [];"
            },
            {
              "line": 52,
              "text": "    let placeholderInserted = false;"
            },
            {
              "line": 53,
              "text": "    for (const block of msg.content) {"
            },
            {
              "line": 54,
              "text": "      if (block.type === \"image\") {"
            },
            {
              "line": 55,
              "text": "        // Collapse runs of images into a single placeholder per message —"
            },
            {
              "line": 56,
              "text": "        // five screenshots don't need five identical notes."
            },
            {
              "line": 57,
              "text": "        if (!placeholderInserted) {"
            },
            {
              "line": 58,
              "text": "          rebuilt.push({ type: \"text\", text: VISION_PLACEHOLDER });"
            },
            {
              "line": 59,
              "text": "          placeholderInserted = true;"
            },
            {
              "line": 60,
              "text": "        }"
            },
            {
              "line": 61,
              "text": "        continue;"
            },
            {
              "line": 62,
              "text": "      }"
            },
            {
              "line": 63,
              "text": "      if ("
            },
            {
              "line": 64,
              "text": "        block.type === \"tool_result\" &&"
            },
            {
              "line": 65,
              "text": "        Array.isArray(block.content) &&"
            },
            {
              "line": 66,
              "text": "        block.content.some((b) => b.type === \"image\")"
            },
            {
              "line": 67,
              "text": "      ) {"
            },
            {
              "line": 68,
              "text": "        rebuilt.push({ ...block, content: stripImageBlocks(block.content) });"
            },
            {
              "line": 69,
              "text": "        continue;"
            },
            {
              "line": 70,
              "text": "      }"
            },
            {
              "line": 71,
              "text": "      rebuilt.push(block);"
            },
            {
              "line": 72,
              "text": "    }"
            },
            {
              "line": 73,
              "text": "    return { ...msg, content: rebuilt };"
            },
            {
              "line": 74,
              "text": "  });"
            },
            {
              "line": 75,
              "text": ""
            },
            {
              "line": 76,
              "text": "  return changed ? out : messages;"
            },
            {
              "line": 77,
              "text": "}"
            },
            {
              "line": 78,
              "text": ""
            },
            {
              "line": 79,
              "text": "/** True if this block holds an image we must elide — either it *is* an image,"
            },
            {
              "line": 80,
              "text": " *  or it's a tool_result whose nested content array contains one. */"
            },
            {
              "line": 81,
              "text": "function needsStrip(block: ContentBlock): boolean {"
            },
            {
              "line": 82,
              "text": "  if (block.type === \"image\") return true;"
            },
            {
              "line": 83,
              "text": "  return ("
            },
            {
              "line": 84,
              "text": "    block.type === \"tool_result\" &&"
            },
            {
              "line": 85,
              "text": "    Array.isArray(block.content) &&"
            },
            {
              "line": 86,
              "text": "    block.content.some((b) => b.type === \"image\")"
            },
            {
              "line": 87,
              "text": "  );"
            },
            {
              "line": 88,
              "text": "}"
            },
            {
              "line": 89,
              "text": ""
            },
            {
              "line": 90,
              "text": "/** Replace image blocks in a ContentBlock[] with a single text placeholder"
            },
            {
              "line": 91,
              "text": " *  (consecutive/multiple images collapse to one), preserving other blocks."
            },
            {
              "line": 92,
              "text": " *  Used for both the message top level and nested tool_result.content. */"
            },
            {
              "line": 93,
              "text": "function stripImageBlocks(blocks: ContentBlock[]): ContentBlock[] {"
            },
            {
              "line": 94,
              "text": "  const rebuilt: ContentBlock[] = [];"
            },
            {
              "line": 95,
              "text": "  let placeholderInserted = false;"
            },
            {
              "line": 96,
              "text": "  for (const block of blocks) {"
            },
            {
              "line": 97,
              "text": "    if (block.type === \"image\") {"
            },
            {
              "line": 98,
              "text": "      if (!placeholderInserted) {"
            },
            {
              "line": 99,
              "text": "        rebuilt.push({ type: \"text\", text: VISION_PLACEHOLDER });"
            },
            {
              "line": 100,
              "text": "        placeholderInserted = true;"
            },
            {
              "line": 101,
              "text": "      }"
            },
            {
              "line": 102,
              "text": "      continue;"
            },
            {
              "line": 103,
              "text": "    }"
            },
            {
              "line": 104,
              "text": "    rebuilt.push(block);"
            },
            {
              "line": 105,
              "text": "  }"
            },
            {
              "line": 106,
              "text": "  return rebuilt;"
            },
            {
              "line": 107,
              "text": "}"
            }
          ]
        }
      ]
    },
