        "line": 3,
        "text": "  mode: \"dom\" | \"console\" | \"network\" | \"performance\" | \"stop\";"
      },
      {
        "line": 4,
        "text": "  /** DOM mode: CSS selector for the subtree to inspect. */"
      },
      {
        "line": 5,
        "text": "  selector?: string;"
      },
      {
        "line": 6,
        "text": "  /** Maximum returned records/nodes, clamped by the inspector. */"
      },
      {
        "line": 7,
        "text": "  maxEntries?: number;"
      },
      {
        "line": 8,
        "text": "}"
      },
      {
        "line": 9,
        "text": ""
      },
      {
        "line": 10,
        "text": "export interface BrowserInspectResult {"
