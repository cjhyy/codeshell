        "text": "  ok: boolean;"
      },
      {
        "line": 12,
        "text": "  mode: BrowserInspectOptions[\"mode\"];"
      },
      {
        "line": 13,
        "text": "  code?: \"BLOCKED\" | \"TARGET_CLOSED\" | \"FAILED\";"
      },
      {
        "line": 14,
        "text": "  url?: string;"
      },
      {
        "line": 15,
        "text": "  data?: unknown;"
      },
      {
        "line": 16,
        "text": "  detail?: string;"
      },
      {
        "line": 17,
        "text": "}"
      },
      {
        "line": 18,
        "text": ""
      },
      {
        "line": 19,
        "text": "/**"
      },
      {
        "line": 20,
        "text": " * Public page operations used by the inspector. The host supplies an authorized"
      },
      {
        "line": 21,
        "text": " * page; this module does not select targets or own the browser connection."
      },
      {
        "line": 22,
        "text": " * Compatible page libraries can implement this port without runtime imports."
      },
      {
        "line": 23,
        "text": " */"
      },
      {
        "line": 24,
        "text": "export interface BrowserInspectorPage {"
