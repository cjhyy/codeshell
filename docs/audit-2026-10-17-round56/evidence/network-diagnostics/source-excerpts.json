      {
        "line": 26,
        "text": "};"
      },
      {
        "line": 27,
        "text": ""
      },
      {
        "line": 28,
        "text": "export async function browserInspectTool("
      },
      {
        "line": 29,
        "text": "  args: Record<string, unknown>,"
      },
      {
        "line": 30,
        "text": "  ctx?: ToolContext,"
      },
      {
        "line": 31,
        "text": "): Promise<string> {"
      },
      {
        "line": 32,
        "text": "  if (!ctx?.browser?.inspect) return \"Error: developer browser inspection is unavailable\";"
      },
      {
        "line": 33,
        "text": "  const mode = args.mode as BrowserInspectOptions[\"mode\"];"
      },
      {
        "line": 34,
        "text": "  if (![\"dom\", \"console\", \"network\", \"performance\", \"stop\"].includes(mode)) {"
      },
      {
        "line": 35,
        "text": "    return \"Error: unsupported browser inspection mode\";"
      },
      {
        "line": 36,
        "text": "  }"
      },
      {
        "line": 37,
        "text": "  if (args.selector !== undefined && typeof args.selector !== \"string\") {"
      },
      {
        "line": 38,
        "text": "    return \"Error: selector must be a CSS selector string\";"
      },
      {
        "line": 39,
        "text": "  }"
      },
      {
        "line": 40,
        "text": "  const maxEntries ="
      },
      {
        "line": 41,
        "text": "    typeof args.max_entries === \"number\" && Number.isFinite(args.max_entries)"
      },
      {
        "line": 42,
        "text": "      ? Math.max(1, Math.min(100, Math.floor(args.max_entries)))"
      },
      {
        "line": 43,
        "text": "      : 50;"
      },
      {
        "line": 44,
        "text": "  const result = await ctx.browser.inspect({"
      },
      {
        "line": 45,
        "text": "    mode,"
      },
      {
        "line": 46,
        "text": "    selector: (args.selector as string | undefined)?.slice(0, 1000),"
      },
      {
        "line": 47,
        "text": "    maxEntries,"
      },
      {
        "line": 48,
        "text": "  });"
      },
      {
        "line": 49,
        "text": "  return JSON.stringify(result);"
      },
      {
        "line": 50,
        "text": "}"
      }
