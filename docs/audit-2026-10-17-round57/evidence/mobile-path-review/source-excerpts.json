    "displayedLines": [
      {
        "line": 1,
        "text": "import { createReadStream, existsSync, realpathSync, statSync } from \"node:fs\";"
      },
      {
        "line": 2,
        "text": "import { isAbsolute, join, normalize, relative, resolve, sep, extname } from \"node:path\";"
      },
      {
        "line": 3,
        "text": "import { request as httpRequest, type IncomingMessage, type ServerResponse } from \"node:http\";"
      },
      {
        "line": 4,
        "text": "import { contentTypeFor } from \"../static-files.js\";"
      },
      {
        "line": 5,
        "text": ""
      },
      {
        "line": 6,
        "text": "/**"
      },
      {
        "line": 7,
        "text": " * Serves the built mobile web app (out/mobile) as static assets for the"
      },
      {
        "line": 8,
        "text": " * `/mobile` route family, replacing the old inline `mobileRemoteHtml()` string."
      },
      {
        "line": 9,
        "text": " *"
      },
      {
        "line": 10,
        "text": " * Two modes:"
      },
      {
        "line": 11,
        "text": " *  - prod: read files from `out/mobile` (resolved relative to the bundled main)."
      },
      {
        "line": 12,
        "text": " *  - dev:  proxy to the mobile vite dev server (MOBILE_DEV_URL) for HMR."
      },
      {
        "line": 13,
        "text": " *"
      },
      {
        "line": 14,
        "text": " * The app is built/served with vite base \"/mobile/\" (vite.mobile.config.ts), so"
      },
      {
        "line": 15,
        "text": " * BOTH the built bundle's asset URLs and vite's dev HMR/module URLs live under"
      },
      {
        "line": 16,
        "text": " * the `/mobile` prefix — a single prefix route serves prod and dev, with no"
      },
      {
        "line": 17,
        "text": " * root-level asset shim or whole-server dev proxy."
      },
      {
        "line": 18,
        "text": " *"
      },
      {
        "line": 19,
        "text": " * Security (design §5): only files INSIDE out/mobile are served. The request"
      },
      {
        "line": 20,
        "text": " * path is normalized and re-resolved; anything that escapes the root → 404."
      },
      {
        "line": 21,
        "text": " * This closes the path-traversal hole the beta1 sweep fixed elsewhere."
      },
      {
        "line": 22,
        "text": " */"
      },
      {
        "line": 23,
        "text": ""
      },
      {
        "line": 24,
        "text": "/** Strip `/mobile` (and an optional trailing slash) off the request URL, drop"
      },
      {
        "line": 25,
        "text": " *  any query/hash, and return the asset sub-path. `/mobile` → \"\", `/mobile/` →"
      },
      {
        "line": 26,
        "text": " *  \"\", `/mobile/assets/x.js` → \"assets/x.js\". */"
      },
      {
        "line": 27,
        "text": "export function mobileAssetPath(reqUrl: string): string {"
      },
      {
        "line": 28,
        "text": "  const noQuery = reqUrl.split(\"?\")[0].split(\"#\")[0];"
      },
      {
        "line": 29,
        "text": "  let rest = noQuery.slice(\"/mobile\".length); // reqUrl always starts with /mobile here"
      },
      {
        "line": 30,
        "text": "  if (rest.startsWith(\"/\")) rest = rest.slice(1);"
      },
      {
        "line": 31,
        "text": "  return rest;"
      },
      {
        "line": 32,
        "text": "}"
      },
      {
        "line": 33,
        "text": ""
      },
      {
        "line": 34,
        "text": "/** If `reqUrl` is the bare `/mobile` entry (optionally with a query/hash but no"
      },
      {
        "line": 35,
        "text": " *  trailing slash), return the canonical `/mobile/`-prefixed target (query/hash"
      },
      {
        "line": 36,
        "text": " *  preserved) for a redirect. Returns null for `/mobile/` and any sub-path,"
      },
      {
        "line": 37,
        "text": " *  which need no redirect. */"
      },
      {
        "line": 38,
        "text": "export function mobileEntryRedirect(reqUrl: string): string | null {"
      },
      {
        "line": 39,
        "text": "  const qIdx = reqUrl.search(/[?#]/);"
      },
      {
        "line": 40,
        "text": "  const path = qIdx === -1 ? reqUrl : reqUrl.slice(0, qIdx);"
      },
      {
        "line": 41,
        "text": "  const suffix = qIdx === -1 ? \"\" : reqUrl.slice(qIdx);"
      },
      {
        "line": 42,
        "text": "  if (path === \"/mobile\") return \"/mobile/\" + suffix;"
      },
      {
        "line": 43,
        "text": "  return null;"
      },
      {
        "line": 44,
        "text": "}"
      },
      {
        "line": 45,
        "text": ""
      },
      {
        "line": 46,
        "text": "/** True when `target` is `root` itself or sits underneath it. Uses `relative`"
      },
      {
        "line": 47,
        "text": " *  rather than a `startsWith` prefix compare so a sibling directory sharing the"
      },
      {
        "line": 48,
        "text": " *  root's name prefix (`/srv/app-old` vs `/srv/app`) can't slip through. */"
      },
      {
        "line": 49,
        "text": "function isContained(root: string, target: string): boolean {"
      },
      {
        "line": 50,
        "text": "  const rel = relative(root, target);"
      },
      {
        "line": 51,
        "text": "  return rel === \"\" || (rel !== \"..\" && !rel.startsWith(`..${sep}`) && !isAbsolute(rel));"
      },
      {
        "line": 52,
        "text": "}"
      },
      {
        "line": 53,
        "text": ""
      },
      {
        "line": 54,
        "text": "/** Resolve an asset sub-path to an absolute file inside `root`, or null if it"
      },
      {
        "line": 55,
        "text": " *  would escape the root (traversal) or does not resolve to a regular file. An"
      },
      {
        "line": 56,
        "text": " *  empty sub-path resolves to index.html (SPA entry)."
      },
      {
        "line": 57,
        "text": " *"
      },
      {
        "line": 58,
        "text": " *  Containment is checked on the REAL paths (both sides `realpathSync`d), not on"
      },
      {
        "line": 59,
        "text": " *  the lexical path: `statSync` follows symlinks, so a link sitting inside the"
      },
      {
        "line": 60,
        "text": " *  root but pointing outside it — e.g. a `node_modules` link left by a packaging"
      },
      {
        "line": 61,
        "text": " *  step — used to pass a string-prefix check and serve the target's contents."
      },
      {
        "line": 62,
        "text": " *  This covers symlinks (including chains and symlinked directories) but NOT"
      },
      {
        "line": 63,
        "text": " *  hardlinks: a hardlink IS a real name inside the root, so no path-level check"
      },
      {
        "line": 64,
        "text": " *  can see through it. Guarding that would need inode/device policy, and anyone"
      },
      {
        "line": 65,
        "text": " *  able to hardlink into the served root can already write files there."
      },
      {
        "line": 66,
        "text": " *"
      },
      {
        "line": 67,
        "text": " *  The returned path is the REQUESTED one, not the realpath: callers stream it"
      },
      {
        "line": 68,
        "text": " *  directly and the resolved-name contract is relied on elsewhere (on macOS the"
      },
      {
        "line": 69,
        "text": " *  realpath of a /var root is /private/var, which would change every result)."
      },
      {
        "line": 70,
        "text": " *  That leaves the same synchronous stat-then-read window this module always"
      },
      {
        "line": 71,
        "text": " *  had; closing it properly needs an open-then-fstat rework of both callers,"
      },
      {
        "line": 72,
        "text": " *  which is out of scope for this fix. */"
      },
      {
        "line": 73,
        "text": "export function resolveSafe(root: string, subPath: string): string | null {"
      },
      {
        "line": 74,
        "text": "  const rootResolved = resolve(root);"
      },
      {
        "line": 75,
        "text": "  const rel = normalize(subPath || \"index.html\");"
      },
      {
        "line": 76,
        "text": "  // Reject absolute paths and any normalized path still containing `..`."
      },
      {
        "line": 77,
        "text": "  if (rel.startsWith(\"..\") || rel.includes(`..${sep}`) || rel.startsWith(sep)) {"
      },
      {
        "line": 78,
        "text": "    return null;"
      },
      {
        "line": 79,
        "text": "  }"
      },
      {
        "line": 80,
        "text": "  const full = resolve(join(rootResolved, rel));"
      },
      {
        "line": 81,
        "text": "  if (!isContained(rootResolved, full)) return null;"
      },
      {
        "line": 82,
        "text": "  if (!existsSync(full) || !statSync(full).isFile()) return null;"
      },
      {
        "line": 83,
        "text": "  // realpathSync throws on a dangling link or a race-deleted file; a missing"
      },
      {
        "line": 84,
        "text": "  // target is a 404 through the normal contract, never a 500."
      },
      {
        "line": 85,
        "text": "  try {"
      },
      {
        "line": 86,
        "text": "    if (!isContained(realpathSync(rootResolved), realpathSync(full))) return null;"
      },
      {
        "line": 87,
        "text": "  } catch {"
      },
      {
        "line": 88,
        "text": "    return null;"
      },
      {
        "line": 89,
        "text": "  }"
      },
      {
        "line": 90,
        "text": "  return full;"
      },
      {
        "line": 91,
        "text": "}"
      },
      {
        "line": 92,
        "text": ""
      },
      {
        "line": 93,
        "text": "/** True when the request is a browser navigation (accepts text/html), used to"
      },
      {
        "line": 94,
        "text": " *  decide whether a path that doesn't resolve to a file should fall back to the"
      },
      {
        "line": 95,
        "text": " *  SPA shell. Asset/module fetches send `*\\/*` or a specific type and must NOT"
      },
      {
        "line": 96,
        "text": " *  fall back (so a missing asset 404s instead of returning HTML). */"
      },
      {
        "line": 97,
        "text": "function acceptsHtml(req: IncomingMessage): boolean {"
      },
      {
        "line": 98,
        "text": "  const accept = req.headers.accept;"
      },
      {
        "line": 99,
        "text": "  return typeof accept === \"string\" && accept.includes(\"text/html\");"
      },
      {
        "line": 100,
        "text": "}"
      },
      {
        "line": 101,
        "text": ""
      },
      {
        "line": 102,
        "text": "export interface MobileStaticOptions {"
      },
      {
        "line": 103,
        "text": "  /** Absolute path to the built mobile app (out/mobile). */"
      },
      {
        "line": 104,
        "text": "  rootDir: string;"
      },
      {
        "line": 105,
        "text": "  /** When set, dev mode: proxy /mobile/* to this base URL instead of disk. */"
      },
      {
        "line": 106,
        "text": "  devUrl?: string;"
      },
      {
        "line": 107,
        "text": "}"
      },
      {
        "line": 108,
        "text": ""
      },
      {
        "line": 109,
        "text": "/**"
      },
      {
        "line": 110,
        "text": " * Handle a `/mobile`-prefixed request. Returns true if it handled the response"
      },
      {
        "line": 111,
        "text": " * (wrote a status), false if the caller should fall through (it never does for"
      },
      {
        "line": 112,
        "text": " * /mobile — callers check the prefix first, so this always handles)."
      },
      {
        "line": 113,
        "text": " */"
      },
      {
        "line": 114,
        "text": "export function serveMobile("
      },
      {
        "line": 115,
        "text": "  req: IncomingMessage,"
      },
      {
        "line": 116,
        "text": "  res: ServerResponse,"
      },
      {
        "line": 117,
        "text": "  opts: MobileStaticOptions,"
      },
      {
        "line": 118,
        "text": "): void {"
      },
      {
        "line": 119,
        "text": "  // Canonicalize the entry URL to a trailing slash. The pairing URL is"
      },
      {
        "line": 120,
        "text": "  // `/mobile?pairing=...` (no slash); without the slash the served HTML's base"
      },
      {
        "line": 121,
        "text": "  // is `/`, so a relative ref would escape the routed prefix. Redirect the bare"
      },
      {
        "line": 122,
        "text": "  // entry → `/mobile/` (preserving the query) so the app always loads under"
      },
      {
        "line": 123,
        "text": "  // `/mobile/`. Sub-paths (/mobile/assets/*) are left untouched."
      },
      {
        "line": 124,
        "text": "  const redirect = mobileEntryRedirect(req.url ?? \"/mobile\");"
      },
      {
        "line": 125,
        "text": "  if (redirect) {"
      },
      {
        "line": 126,
        "text": "    res.writeHead(308, { location: redirect });"
      },
      {
        "line": 127,
        "text": "    res.end();"
      },
      {
        "line": 128,
        "text": "    return;"
      },
      {
        "line": 129,
        "text": "  }"
      },
      {
        "line": 130,
        "text": "  if (opts.devUrl) {"
      },
      {
        "line": 131,
        "text": "    proxyToDev(req, res, opts.devUrl);"
      },
      {
        "line": 132,
        "text": "    return;"
      },
      {
        "line": 133,
        "text": "  }"
      },
      {
        "line": 134,
        "text": "  const sub = mobileAssetPath(req.url ?? \"/mobile\");"
      },
      {
        "line": 135,
        "text": "  let file = resolveSafe(opts.rootDir, sub);"
      },
      {
        "line": 136,
        "text": "  // SPA fallback: a navigation to an unknown client route → index.html so the"
      },
      {
        "line": 137,
        "text": "  // React router can take over. Gate on the request ACCEPTing html (the browser"
      },
      {
        "line": 138,
        "text": "  // sends `Accept: text/html` for navigations, `*/*` or a specific type for"
      },
      {
        "line": 139,
        "text": "  // asset/module fetches), NOT on the absence of a file extension — a route"
      },
      {
        "line": 140,
        "text": "  // segment containing a dot (e.g. a version or dotted id) must still fall back,"
      },
      {
        "line": 141,
        "text": "  // and a genuinely-missing .js/.css must still 404 (returning HTML for a module"
      },
      {
        "line": 142,
        "text": "  // request would break module loading)."
      },
      {
        "line": 143,
        "text": "  if (!file && sub && acceptsHtml(req)) {"
      },
      {
        "line": 144,
        "text": "    file = resolveSafe(opts.rootDir, \"index.html\");"
      },
      {
        "line": 145,
        "text": "  }"
      },
      {
        "line": 146,
        "text": "  if (!file) {"
      },
      {
        "line": 147,
        "text": "    res.writeHead(404, { \"content-type\": \"text/plain; charset=utf-8\" });"
      },
      {
        "line": 148,
        "text": "    res.end(\"not found\");"
      },
      {
        "line": 149,
        "text": "    return;"
      },
      {
        "line": 150,
        "text": "  }"
      },
      {
        "line": 151,
        "text": "  const type = contentTypeFor(extname(file));"
      },
      {
        "line": 152,
        "text": "  // Hashed bundles under /assets are content-addressed → cache forever. The"
      },
      {
        "line": 153,
        "text": "  // entry HTML (index.html, served for \"\" or the SPA fallback) must NOT be"
      },
      {
        "line": 154,
        "text": "  // cached: after an app upgrade ships a new bundle with new hashed filenames, a"
      },
      {
        "line": 155,
        "text": "  // stale index.html would reference deleted assets → 404 → blank page until a"
      },
      {
        "line": 156,
        "text": "  // hard refresh."
      },
      {
        "line": 157,
        "text": "  const isHtml = type.startsWith(\"text/html\");"
      },
      {
        "line": 158,
        "text": "  res.writeHead(200, {"
      },
      {
        "line": 159,
        "text": "    \"content-type\": type,"
      },
      {
        "line": 160,
        "text": "    \"cache-control\": isHtml"
      },
      {
        "line": 161,
        "text": "      ? \"no-store\""
      },
      {
        "line": 162,
        "text": "      : sub.startsWith(\"assets/\")"
      },
      {
        "line": 163,
        "text": "        ? \"public, max-age=31536000, immutable\""
      },
      {
        "line": 164,
        "text": "        : \"no-cache\","
      },
      {
        "line": 165,
        "text": "  });"
      },
      {
        "line": 166,
        "text": "  createReadStream(file).pipe(res);"
      },
      {
        "line": 167,
        "text": "}"
      },
      {
        "line": 168,
        "text": ""
      },
      {
        "line": 169,
        "text": "/** Dev-only: forward the request to the mobile vite dev server. The mobile vite"
      },
      {
        "line": 170,
        "text": " *  config sets base \"/mobile/\", so vite serves its HMR client, module graph, and"
      },
      {
        "line": 171,
        "text": " *  asset URLs UNDER that prefix (/mobile/@vite/client, /mobile/src/main.tsx). We"
      },
      {
        "line": 172,
        "text": " *  therefore forward the request path UNCHANGED — stripping /mobile would ask"
      },
      {
        "line": 173,
        "text": " *  vite for /@vite/client, which a base-\"/mobile/\" server 404s, breaking HMR so"
      },
      {
        "line": 174,
        "text": " *  the phone never live-updates. The /mobile prefix belongs to vite here (its"
      },
      {
        "line": 175,
        "text": " *  base), not to us — only prod static serving strips it (files live flat under"
      },
      {
        "line": 176,
        "text": " *  out/mobile). */"
      },
      {
        "line": 177,
        "text": "function proxyToDev(req: IncomingMessage, res: ServerResponse, devUrl: string): void {"
      },
      {
        "line": 178,
        "text": "  const target = new URL(devUrl);"
      },
      {
        "line": 179,
        "text": "  const proxyReq = httpRequest("
      },
      {
        "line": 180,
        "text": "    {"
      },
      {
        "line": 181,
        "text": "      hostname: target.hostname,"
      },
      {
        "line": 182,
        "text": "      port: target.port,"
      },
      {
        "line": 183,
        "text": "      method: req.method,"
      },
      {
        "line": 184,
        "text": "      path: req.url ?? \"/mobile/\","
      },
      {
        "line": 185,
        "text": "      headers: { ...req.headers, host: target.host },"
      },
      {
        "line": 186,
        "text": "    },"
      },
      {
        "line": 187,
        "text": "    (proxyRes) => {"
      },
      {
        "line": 188,
        "text": "      // Never let a phone cache the DEV page/assets. Otherwise a stale static"
      },
      {
        "line": 189,
        "text": "      // build's HTML (hash-named assets) survives in the browser cache and its"
      },
      {
        "line": 190,
        "text": "      // asset requests hit the vite dev server, which has no hash files → 404."
      },
      {
        "line": 191,
        "text": "      // no-store on every dev response keeps the phone in lockstep with vite."
      },
      {
        "line": 192,
        "text": "      const headers = { ...proxyRes.headers, \"cache-control\": \"no-store\" };"
      },
      {
        "line": 193,
        "text": "      res.writeHead(proxyRes.statusCode ?? 502, headers);"
      },
      {
        "line": 194,
        "text": "      proxyRes.pipe(res);"
      },
      {
        "line": 195,
        "text": "    },"
      },
      {
        "line": 196,
        "text": "  );"
      },
      {
        "line": 197,
        "text": "  proxyReq.on(\"error\", () => {"
      },
      {
        "line": 198,
        "text": "    res.writeHead(502, { \"content-type\": \"text/plain; charset=utf-8\" });"
      },
      {
        "line": 199,
        "text": "    res.end(\"mobile dev server unavailable\");"
      },
      {
        "line": 200,
        "text": "  });"
      },
      {
        "line": 201,
        "text": "  req.pipe(proxyReq);"
      },
      {
        "line": 202,
        "text": "}"
      }
    ]
  },
  {
    "path": "packages/server/src/mobile-remote/remote-host-manager.ts",
    "sha256": "e7956da57e9d9b1581909a78492dd3834a0cf916af26131f6c8cfdba31e005ca",
    "captureTiming": "After actual source displays9c73e6/6411c6/f4f16b/7eb32d/70c38c; only previously displayed body/navigation lines, not first-read/pre-read capture.",
    "displayedLines": [
      {
        "line": 23,
        "text": " * and common VPN/tunnel ranges (198.18.x carrier-grade test net used by some"
      },
      {
        "line": 42,
        "text": "    ip.startsWith(\"192.168.\") || ip.startsWith(\"10.\") || /^172\\.(1[6-9]|2\\d|3[01])\\./.test(ip);"
      },
      {
        "line": 70,
        "text": "  onClientEvent: (event: unknown, ws: WebSocket) => void | Promise<void>;"
      },
      {
        "line": 71,
        "text": "  /**"
      },
      {
        "line": 72,
        "text": "   * Absolute path to the built mobile app (out/mobile). Defaults to the"
      },
      {
        "line": 73,
        "text": "   * sibling of the bundled main (out/main → ../mobile). Overridable for tests."
      },
      {
        "line": 74,
        "text": "   */"
      },
      {
        "line": 75,
        "text": "  mobileRootDir?: string;"
      },
      {
        "line": 76,
        "text": "  /**"
      },
      {
        "line": 107,
        "text": "  /** Where the built mobile app lives (out/mobile). */"
      },
      {
        "line": 108,
        "text": "  private readonly mobileRootDir: string;"
      },
      {
        "line": 114,
        "text": "    // Bundled main is out/main/index.mjs → mobile app is the sibling out/mobile."
      },
