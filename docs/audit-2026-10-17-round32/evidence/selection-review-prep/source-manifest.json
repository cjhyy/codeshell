  "decisions": [
    {
      "subject": "Boundary-at-loop-start suspicion",
      "decision": "Rejected for current source. finalizeModelTurn closes a completed model turn once after response return; ordinary final assistant emission and tool-result recording precede relevant closing calls."
    },
    {
      "subject": "Model iteration versus selectable user task",
      "decision": "A segment without a real user is appended to the previous task. Multiple model boundaries do not by themselves split one user task or omit continuation."
    },
    {
      "subject": "Backend range handling",
      "decision": "Unique ordered endpoint inclusive slice, no silent range widening; context projection and tool-pair validation reject mismatched/orphan/unfinished tool ranges before summarization. No actual selection/fork/model call."
    },
