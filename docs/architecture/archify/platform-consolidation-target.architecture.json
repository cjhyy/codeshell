  "cards": [
    {
      "dot": "cyan",
      "title": "一个宿主，三种部署",
      "items": [
        "HostRuntime 是唯一宿主实现，Electron main 只剩窗口与系统集成",
        "Desktop / serve 常驻，沙箱一任务一容器，云端不跑常驻状态"
      ]
    },
    {
      "dot": "violet",
      "title": "一个协议，平等客户端",
      "items": [
        "握手声明双方能力，不支持的能力立即返回 host_unsupported",
        "Turn 输出走 journal cursor，宿主状态走 stateVersion"
      ]
    },
    {
      "dot": "amber",
      "title": "一个入口管审批与子进程",
      "items": [
        "所有策略源汇入 PolicyEngine，deny 优先、allow 按层级",
        "所有子进程经 ExecutionService，沙箱先 report-only 再 enforce"
      ]
    }
  ]
}
