      "variant": "return"
    },
    {
      "id": "m5",
      "from": "protocol",
      "to": "core",
      "y": 272,
      "label": "注入覆盖上下文并开启 loop",
      "variant": "default",
      "note": "将全仓库扫描结果与可读性上下文（顶层路径统计）挂载到会话上下文。"
    },
    {
      "id": "m6",
      "from": "core",
      "to": "llm",
      "y": 300,
      "label": "LLM request",
      "variant": "default",
      "note": "构建上下文后请求模型。若有 steer 队列，在每次请求前写入。"
    },
    {
      "id": "m7",
      "from": "llm",
      "to": "core",
      "y": 328,
      "label": "text / tool_calls",
      "variant": "return",
      "note": "模型返回文本或工具调用。"
    },
    {
      "id": "m8",
      "from": "core",
      "to": "tools",
      "y": 356,
      "label": "执行 tools",
      "variant": "default",
      "note": "工具执行时注入 cancel signal（同一轮内并发执行，多 tool_result 回流）。"
    },
    {
      "id": "m9",
      "from": "core",
      "to": "ui",
      "y": 384,
      "label": "增量输出",
      "variant": "return",
      "note": "Steer 在本次工具组完成前不会直接打断；在下一轮模型请求前入队后注入。Stop 在 pending 阶段可直接中断。"
    },
    {
      "id": "m10",
      "from": "ui",
      "to": "protocol",
      "y": 412,
      "label": "Stop",
      "variant": "security",
      "note": "触发 session.cancel，走 abort 回调；Core 仅注册并广播取消信号，等待中的工具请求 / LLM 请求按信号立即退出，turn-loop 判定已取消后停止下一轮。"
    }
  ]
