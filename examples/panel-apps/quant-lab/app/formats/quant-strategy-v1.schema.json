{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Repository format owned by the Quant Lab Panel App.",
  "title": "CodeShell Quant Strategy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "dataset", "sample", "strategy", "execution"],
  "properties": {
    "format": {
      "const": "codeshell.quant-strategy"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sample": {
      "$ref": "#/$defs/sample"
    },
    "strategy": {
      "oneOf": [
        {
          "$ref": "#/$defs/smaCross"
        },
        {
          "$ref": "#/$defs/rsiReversion"
        },
        {
          "$ref": "#/$defs/breakout"
        }
      ]
    },
    "execution": {
      "$ref": "#/$defs/execution"
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bars", "from", "to", "fingerprint"],
      "properties": {
        "bars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100000
        },
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^fnv1a32:[0-9a-f]{8}$"
        }
      }
    },
    "smaCross": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fast", "slow"],
      "properties": {
        "type": {
          "const": "sma-cross"
        },
        "fast": {
          "type": "integer",
          "minimum": 2
        },
        "slow": {
          "type": "integer",
          "minimum": 3
        }
      }
    },
    "rsiReversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "period", "oversold", "overbought"],
      "properties": {
        "type": {
          "const": "rsi-reversion"
        },
        "period": {
          "type": "integer",
          "minimum": 2
        },
        "oversold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "overbought": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "breakout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "lookback"],
      "properties": {
        "type": {
          "const": "breakout"
        },
        "lookback": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialCapital", "feeBps", "slippageBps", "stopLossPct"],
      "properties": {
        "initialCapital": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "feeBps": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 10000
        },
        "slippageBps": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 10000
        },
        "stopLossPct": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 100
        }
      }
    }
  }
}
