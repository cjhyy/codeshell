    {
      "id": "interrupted-reply-later-restart",
      "version": 1,
      "title": "中断回复在后续完整重启后丢失",
      "adapter": "desktop",
      "executionCoverage": {
        "liveEnabled": true,
        "historicalLevels": ["packaged_fixed_provider"],
        "currentNonLiveEntry": "repository-regression",
        "note": "案例定义不表示本轮已执行；结果由独立运行报告记录。"
      },
      "failureBasis": "actual-packaged",
      "input": {
        "prompts": [
          "请用三段解释如何给书架分类，每段带上标记 {{caseNonce}}。",
          "请用一句话建议书架整理完成后的维护习惯。",
          "再补充一个不同的维护习惯。"
        ],
        "variables": ["caseNonce"],
        "files": []
      },
      "environment": {
        "fixture": "synthetic-isolated",
        "workspace": "temporary",
        "profile": "temporary",
        "externalWrites": false,
        "model": "live-selected-provider"
      },
      "requirements": [
        "event-driven-trigger",
        "identity-and-artifact-capture",
        "packaged-electron",
        "real-ipc",
        "live-model-stream"
      ],
      "steps": [
        {
          "when": "第一条实际回复已收到非空正文、请求尚未终结",
          "action": "记录真实收到的正文，然后完整退出应用；确认实际HTTP中止。"
        },
        {
          "when": "首次完整启动",
          "action": "确认原输入与已收到正文仍在，再发送第二条并等待完成。"
        },
        {
          "when": "第二次完整启动",
          "action": "确认原中断正文仍在，发送第三条并完成；随后第三次完整启动。"
        }
      ],
      "hardAssertions": [
        {
          "id": "received-prefix-preserved",
          "criterion": "首次、第二次、第三次启动后，实际退出前收到的正文均保留在原用户回合。",
          "requiredEvidence": ["pre-exit-stream", "transcript-after-restart"]
        },
        {
          "id": "intent-unique",
          "criterion": "三条用户输入各一次；已完成回复各一次，中断正文不被移到后续回合。",
          "requiredEvidence": ["client-message-ids", "transcript-after-restart"]
        },
        {
          "id": "no-reexecution",
          "criterion": "重启自身不触发旧intent额外模型或工具执行。",
          "requiredEvidence": ["model-request-log", "tool-execution-log"]
        }
      ],
      "semanticRubric": {
        "version": 1,
        "applicability": "live-output",
        "criteria": [
          {
            "id": "semantic-1",
            "criterion": "已完成的第二、第三条回复分别回应对应维护问题，第三条不是机械重复第二条。"
          },
          {
            "id": "semantic-2",
            "criterion": "保留的中断正文只按实际收到的内容评价，不要求中断运行伪装成完整成功。"
          }
        ],
        "notApplicableReason": null
      },
      "repositoryRegression": [
        "packages/desktop/src/renderer/app/mergeHistoryWindows.test.ts",
        "packages/desktop/src/renderer/transcriptHydration.prefix.test.ts"
      ],
      "provenance": {
